{
  "name": "noai",
  "version": "0.3.0",
  "private": true,
  "description": "NOAI, pronounced No Eye. A personal AI that answers questions about your life without the model ever seeing it.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "noai": "node --env-file-if-exists=.env src/cli.ts",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "web": "node --env-file-if-exists=.env relay/serve.mjs",
    "mcp": "node --env-file-if-exists=.env src/mcp-serve.ts",
    "model": "node scripts/fetch-model.ts",
    "build:web": "node scripts/build-web.ts",
    "pretest": "node scripts/build-web.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "onnxruntime-web": "1.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
