{
  "manifest_version": 3,
  "name": "NOAI+ for chat sites",
  "short_name": "NOAI+",
  "version": "0.1.0",
  "description": "Hides names, numbers and IDs on this computer before you send to ChatGPT, Copilot or Gemini, and puts them back in the answer on your screen.",
  "minimum_chrome_version": "137",
  "permissions": ["storage"],
  "background": { "service_worker": "lib/extension/src/background.js", "type": "module" },
  "storage": { "managed_schema": "managed_schema.json" },
  "action": { "default_popup": "popup.html", "default_title": "NOAI+", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://copilot.microsoft.com/*",
        "https://gemini.google.com/*",
        "http://127.0.0.1/noai-extension-test/*"
      ],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "tenor-sans.woff2"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://copilot.microsoft.com/*",
        "https://gemini.google.com/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
